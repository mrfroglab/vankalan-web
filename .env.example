# Konfigurasi Aplikasi
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
TZ=Asia/Jakarta

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/warmindo_vangkalan?schema=public"

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=your-midtrans-server-key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

# WAHA (WhatsApp HTTP API di Homeserver Bang Jan)
WAHA_BASE_URL=http://localhost:3008
WAHA_SESSION=default
WAHA_API_KEY=your-waha-api-key

# Backend (route handler Next.js di aplikasi yang sama)
# Kosong = frontend memakai localStorage (mode prototipe). Isi dengan URL app agar memakai /api/* + database.
NEXT_PUBLIC_API_URL=
# Hanya dev/sandbox: izinkan PATCH /api/orders/:id/payment menandai PAID tanpa webhook.
# Jangan aktifkan di production (PAID harus dari webhook Midtrans terverifikasi).
ALLOW_PAYMENT_SIMULATION=false

# Login admin (wajib di production; tanpa ini endpoint admin dijawab 503 dan /admin diarahkan ke login)
# ADMIN_PASSWORD: kata sandi bersama penjaga. SESSION_SECRET: minimal 32 karakter -> openssl rand -base64 48
ADMIN_PASSWORD=
SESSION_SECRET=

# Midtrans (server). Dengan MIDTRANS_SERVER_KEY terisi, POST /api/orders membuat transaksi Snap
# dan status PAID hanya datang dari webhook: <NEXT_PUBLIC_APP_URL>/api/payments/midtrans/notification
# (daftarkan URL itu di Midtrans Dashboard > Settings > Payment > Notification URL).
MIDTRANS_EXPIRY_MINUTES=15
# Akun Midtrans baru: server key di atas = server key ber-scope (Access Keys > General Credentials >
# Generate server key; izin Snap Checkout=Write, Core API=Read), dan signature notifikasi memakai
# "Signature Secret Key" dari halaman yang sama. Kosongkan untuk akun lama (signature = server key).
MIDTRANS_SIGNATURE_KEY=
# Opsional, override host Midtrans (mis. untuk uji): MIDTRANS_SNAP_API_URL, MIDTRANS_CORE_API_URL

# Antrean WhatsApp (WAHA). Pekerja berjalan otomatis di server (src/instrumentation.ts).
# Jeda retry setelah gagal pasti (detik), lalu FAILED = perlu kirim ulang manual. Default: 30,120,300
WA_RETRY_DELAYS_SECONDS=30,120,300
# Timeout kirim ke WAHA (ms, min 1000). Timeout = UNKNOWN: riwayat WA diperiksa sebelum retry.
WAHA_TIMEOUT_MS=10000
# Jeda sebelum riwayat WA diperiksa untuk pesan UNKNOWN (detik, default 120)
WA_VERIFY_DELAY_SECONDS=120
# Matikan pekerja (mis. di instance kedua): WA_WORKER_ENABLED=false. Interval tick (ms, min 2000):
WA_WORKER_INTERVAL_MS=10000

# Retensi data (USULAN default; TBD-08 belum diputuskan pemilik warung)
ORDER_LINK_TTL_DAYS=30       # tautan privat order kedaluwarsa (pesanan lunas yang masih berjalan tidak pernah putus)
PII_RETENTION_DAYS=90        # nama/WA/catatan pelanggan dianonimkan untuk pesanan selesai/batal
UNPAID_RETENTION_DAYS=7      # pesanan yang tidak pernah lunas dihapus
EVENT_RETENTION_DAYS=180     # payload mentah log event pembayaran dikosongkan
